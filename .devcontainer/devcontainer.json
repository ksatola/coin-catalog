{
  "name": "coin-catalog-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/coin-catalog",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "Vue.volar",
        "OpenAI.chatgpt"
      ]
    }
  },
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": {
      "label": "Backend"
    },
    "5173": {
      "label": "Frontend"
    }
  },
  "remoteUser": "root"
}
