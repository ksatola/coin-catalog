#!/usr/bin/env bash
set -euo pipefail

RUN_DIR="/tmp/coin-catalog"

echo "Coin Catalog status"
echo

for name_port in "backend:8000" "frontend:5173"; do
    name="${name_port%%:*}"
    port="${name_port##*:}"
    pid_file="$RUN_DIR/$name.pid"

    echo "$name:"

    if [[ -f "$pid_file" ]]; then
        pid="$(cat "$pid_file")"

        if kill -0 "$pid" 2>/dev/null; then
            echo "  process: OK (PID $pid)"
        else
            echo "  process: NOT RUNNING (stale PID $pid)"
        fi
    else
        echo "  process: NOT RUNNING"
    fi

    if ss -ltn 2>/dev/null | grep -q ":$port "; then
        echo "  port:    LISTEN ($port)"
    else
        echo "  port:    FREE ($port)"
    fi

    echo "  URL:     http://localhost:$port"
    echo
done

